<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ejercicio1punto5.PrimaryController">
<children>
      <Label text="Alimentacion:" />
      <TextField fx:id="txtAlimentacion" />
      <Label text="Refrigerios:" />
      <TextField fx:id="txtRefrigerios" />
      <Label text="Transporte:" />
      <TextField fx:id="txtTransporte" />
      <Label text="Telefonia:" />
      <TextField fx:id="txtTelefonia" />
      <Label text="Otros:" />
      <TextField fx:id="txtOtros" />
      
      <Button text="Calcular estadisticas" onAction="#btnCalcular_click" />
      <Button text="Limpiar" onAction="#btnLimpiar_click" />
      
      <Label text="Total semanal:" />
      <TextField fx:id="txtTotal" />
      
      <Label text="Gasto mas alto:" />
      <TextField fx:id="txtGastoMayor" />
   </children>
</VBox>