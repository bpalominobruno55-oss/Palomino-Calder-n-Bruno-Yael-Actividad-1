<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Button?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ejercicio1punto3.PrimaryController">
<children>
      <Label text="Ingrese un numero:" />
      <TextField fx:id="txtNumero" />
      <Button text="Analizar" onAction="#btnAnalizar_click" />
      <Button text="Limpiar" onAction="#btnLimpiar_click" />
      
      <Label text="Cantidad de cifras:" />
      <TextField fx:id="txtCantidad" />
      
      <Label text="Suma de cifras impares:" />
      <TextField fx:id="txtImpares" />
      
      <Label text="Suma de cifras pares:" />
      <TextField fx:id="txtPares" />
      
      <Label text="Suma total de cifras:" />
      <TextField fx:id="txtTotal" />
      
      <Label text="Cifra mayor:" />
      <TextField fx:id="txtMayor" />
      
      <Label text="Cifra menor:" />
      <TextField fx:id="txtMenor" />
      
      <Label text="Divisores:" />
      <TextArea fx:id="txtDivisores" />
   </children>
</VBox>